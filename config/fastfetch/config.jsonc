{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // dragão oficial do Kali (recortado do kali-dragon-icon.svg), desenhado
        // com caracteres braille; a largura vem da função fastfetch do ~/.zshrc
        "type": "chafa",
        "source": "~/.config/fastfetch/kali-dragao.png",
        "chafa": { "symbols": "braille", "fgOnly": true },
        "color": { "1": "#88c0d0", "2": "#5e81ac" },
        "padding": { "top": 1, "right": 4, "left": 2 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "#88c0d0", "title": "#81a1c1" },
        "key": { "width": 12 }
    },
    "modules": [
        "title",
        { "type": "custom", "format": "\u001b[38;2;42;48;59m──────────────────────" },
        { "type": "os",       "key": "  os" },
        { "type": "kernel",   "key": "  kernel" },
        { "type": "wm",       "key": "  wm" },
        { "type": "shell",    "key": "  shell" },
        { "type": "terminal", "key": "  term" },
        { "type": "packages", "key": "  pkgs" },
        { "type": "cpu",      "key": "  cpu", "format": "{name}" },
        { "type": "memory",   "key": "  mem" },
        { "type": "uptime",   "key": "  uptime" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
